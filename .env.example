# Portfolio Analytics Configuration
# Copy this to .env and fill in values

# Database
DB_PATH=data/portfolio.db

# Data paths
HOLDINGS_PATH=data/samples/portfolio_holdings.csv
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Price fetch settings
PRICE_START_DATE=2024-01-01
PRICE_END_DATE=

# Fama-French factors
# Options: F-F_Research_Data_Factors_daily, F-F_Research_Data_5_Factors_2x3_daily
FF_FACTOR_DATASET=F-F_Research_Data_Factors_daily

# Analytics settings
RISK_FREE_RATE_ANNUAL=0.05
VAR_CONFIDENCE=0.95
TRADING_DAYS_PER_YEAR=252

# Reporting
REPORT_OUTPUT_DIR=artifacts/reports
FIGURES_OUTPUT_DIR=artifacts/figures
LOG_DIR=artifacts/logs

# Scheduling (cron format, optional)
SCHEDULE_CRON=0 8 * * 1
